# ---------------------------------------------------------------------------
# AD Admin Portal - OPTIONAL server settings.
#
# You normally do NOT need this file: open the portal in a browser and the
# setup wizard asks for everything (domain controller, service account, OUs,
# role groups, branding, new-user defaults). Those are saved in data/settings.json.
#
# Use this file only for server-level options, or to pre-configure AD for an
# automated deployment (settings saved in the web UI take priority).
# ---------------------------------------------------------------------------

PORT=3200

# HTTPS: either let a reverse proxy (IIS / nginx / k8s ingress) handle TLS and set
# TRUST_PROXY=true, or point these at a PEM certificate + key to serve HTTPS directly.
TRUST_PROXY=false
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Where settings and the audit log are kept (relative to the app folder)
DATA_DIR=./data
AUDIT_LOG_FILE=./logs/audit.jsonl

# Optional: your own secrets instead of the auto-generated ones in data/
# SESSION_SECRET=<long random string>
# SETTINGS_KEY=<long random string used to encrypt the service-account password>

# --- Optional AD pre-configuration (same as the setup wizard) --------------
# Lists of DNs are separated with "|"
# LDAP_URL=ldaps://dc01.corp.local:636
# LDAP_CA_CERT=./certs/root-ca.pem
# LDAP_BASE_DN=DC=corp,DC=local
# LDAP_BIND_DN=svc-adportal@corp.local
# LDAP_BIND_PASSWORD=
# AD_UPN_SUFFIX=corp.local
# MANAGED_USER_OUS=OU=Staff,DC=corp,DC=local
# MANAGED_GROUP_OUS=OU=Groups,DC=corp,DC=local
# ROLE_ADMIN_GROUP=CN=ADPortal-Admins,OU=Groups,DC=corp,DC=local
# ROLE_HELPDESK_GROUP=CN=ADPortal-Helpdesk,OU=Groups,DC=corp,DC=local
# ORG_NAME=Your Company
